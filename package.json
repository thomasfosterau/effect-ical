{
  "name": "@thomasfosterau/effect-ical",
  "version": "0.0.0",
  "description": "iCal (RFC 5545) library using Effect idioms for encoding and decoding iCalendar files",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ical",
    "icalendar",
    "calendar",
    "rfc5545",
    "effect",
    "effect-ts",
    "parser",
    "encoder",
    "decoder"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/bun": "^1.3.0",
    "effect": "^3.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "prettier": "^3.4.2",
    "eslint": "^9.18.0"
  },
  "peerDependencies": {
    "effect": "^3.0.0"
  }
}
