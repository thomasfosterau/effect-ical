{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-ical",
  "version": "0.0.0",
  "description": "iCalendar (RFC 5545) encoding and decoding for Effect: typed components, a parser, an encoder and pipeable builders.",
  "keywords": [
    "calendar",
    "decoder",
    "effect",
    "effect-ts",
    "encoder",
    "ical",
    "icalendar",
    "parser",
    "rfc5545"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ical#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ical/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ical.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "changeset": "changeset",
    "changeset:version": "changeset version && vp fmt",
    "changeset:publish": "vp run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.6"
}
