{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-ical",
  "version": "0.1.0",
  "description": "iCalendar (RFC 5545) and vCard (RFC 6350) encoding and decoding for Effect: typed components, parsers, encoders and pipeable builders.",
  "keywords": [
    "calendar",
    "decoder",
    "effect",
    "effect-ts",
    "encoder",
    "ical",
    "icalendar",
    "parser",
    "rfc5545",
    "rfc6350",
    "vcard"
  ],
  "homepage": "https://www.npmjs.com/package/@thomasfosterau/effect-ical",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ical/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ical.git"
  },
  "files": [
    "dist",
    "docs/api.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Calendar": {
      "types": "./dist/Calendar.d.ts",
      "import": "./dist/Calendar.js"
    },
    "./ContentLine": {
      "types": "./dist/ContentLine.d.ts",
      "import": "./dist/ContentLine.js"
    },
    "./Event": {
      "types": "./dist/Event.d.ts",
      "import": "./dist/Event.js"
    },
    "./Todo": {
      "types": "./dist/Todo.d.ts",
      "import": "./dist/Todo.js"
    },
    "./VCard": {
      "types": "./dist/VCard.d.ts",
      "import": "./dist/VCard.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:peers",
    "effect": "catalog:peers"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6"
}
